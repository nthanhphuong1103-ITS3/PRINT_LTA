{
  "manifest_version": 3,
  "name": "LTA Print Guard",
  "version": "1.0",
  "description": "Chặn lệnh in Ctrl+P và yêu cầu đăng nhập hệ thống LTA Print trước khi in.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "commands": {
    "intercept-print": {
      "suggested_key": {
        "default": "Ctrl+P",
        "mac": "Command+P"
      },
      "description": "Bắt lệnh in"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "exclude_matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LTA Print Guard"
  }
}
